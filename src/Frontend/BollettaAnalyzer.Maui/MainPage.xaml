<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BollettaAnalyzer.Maui.MainPage"
             Title="Bolletta Analyzer">

    <!--
      HybridWebView ospita la SPA React buildata in Resources/Raw/wwwroot.
      HybridRoot punta alla cartella dei MauiAsset; DefaultFile è la pagina iniziale.
    -->
    <HybridWebView x:Name="webView"
                   HybridRoot="wwwroot"
                   DefaultFile="index.html" />

</ContentPage>
