<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>BollettaAnalyzer.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Identità app -->
    <ApplicationTitle>Bolletta Analyzer</ApplicationTitle>
    <ApplicationId>net.talete.bollettaanalyzer</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icona app (genera i mipmap appicon/appicon_round referenziati da AndroidManifest.xml)
         e splash screen. Sfondo = gradiente brand, glifo = fulmine bianco. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6366F1" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#6366F1" BaseSize="128,128" />

    <!--
      Il contenuto React buildato finisce in Resources\Raw\wwwroot ed è incluso
      automaticamente come MauiAsset dall'SDK MAUI, preservando il percorso "wwwroot/…"
      richiesto dall'HybridWebView (HybridRoot="wwwroot").
    -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <!--
    Registra, al momento della VALUTAZIONE del progetto, se la SPA React è già presente:
    è esattamente la condizione in cui la glob MauiAsset dell'SDK MAUI la include nel
    pacchetto. Le glob sono infatti valutate al caricamento del progetto, prima che i
    target girino, quindi un client generato durante il build entra nel pacchetto solo
    dalla compilazione successiva.
  -->
  <PropertyGroup>
    <_ClientPresenteAllaValutazione Condition="Exists('Resources\Raw\wwwroot\index.html')">true</_ClientPresenteAllaValutazione>
  </PropertyGroup>

  <!--
    Build automatica del client React prima della compilazione MAUI.
    Richiede Node/npm installati. Disattivabile con -p:SkipClientBuild=true.
  -->
  <Target Name="BuildReactClient" BeforeTargets="BeforeBuild" Condition="'$(SkipClientBuild)' != 'true'">
    <Message Importance="high" Text="Build del client React (ClientApp)…" />
    <Exec Command="npm install" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />

    <Error Condition="!Exists('Resources\Raw\wwwroot\index.html')"
           Text="Il build del client React non ha prodotto Resources\Raw\wwwroot\index.html. Controlla l'output di 'npm run build' in ClientApp." />

    <!--
      Primo build su clone fresco: i file sono appena stati creati e la glob dell'SDK
      non li ha visti, quindi NON sono nel pacchetto e l'app mostrerebbe il pannello
      "Client React non impacchettato". Basta ricompilare: al secondo build la glob li include.
      Si avvisa in modo esplicito invece di aggiungerli qui a mano, perché i metadati
      %(...) dentro un target attivano il batching di MSBuild e produrrebbero
      LogicalName errati (errore MSB3024 in fase di copia degli asset).
    -->
    <Warning Condition="'$(_ClientPresenteAllaValutazione)' != 'true'"
             Text="Client React generato ORA: non era presente all'avvio della compilazione, quindi non è incluso in questo pacchetto. Ricompila (Compila di nuovo) per includerlo." />

    <Message Condition="'$(_ClientPresenteAllaValutazione)' == 'true'"
             Importance="high" Text="Client React presente e incluso nel pacchetto (wwwroot)." />
  </Target>

</Project>
