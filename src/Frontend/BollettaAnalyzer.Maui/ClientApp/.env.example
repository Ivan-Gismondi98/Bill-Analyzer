# Copia in .env.local per lo sviluppo.

# true = usa i dati mock, nessun backend richiesto (utile per lavorare sulla UI
# o per provare l'app senza avviare l'API).
VITE_USE_MOCK=false

# Base URL delle API. Se NON impostata, viene risolta automaticamente:
#   - dev server Vite (localhost)   -> /api   (il proxy inoltra a :5080)
#   - app MAUI su emulatore Android -> http://10.0.2.2:5080/api
#
# Impostala solo per puntare a un backend specifico, per esempio:
# VITE_API_BASE_URL=https://api.miodominio.it/api
#
# Su dispositivo Android fisico serve l'IP della macchina di sviluppo nella
# stessa rete, es. http://192.168.1.50:5080/api
