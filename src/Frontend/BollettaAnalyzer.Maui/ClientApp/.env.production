# Configurazione usata da `npm run build` (build di Release / pubblicazione).
#
# PRIMA DI PUBBLICARE: scommenta e imposta l'URL PUBBLICO (HTTPS) del backend.
# Senza questo valore l'app pubblicata proverebbe a chiamare l'host di sviluppo
# dell'emulatore (10.0.2.2), che sui dispositivi degli utenti non esiste.
#
# VITE_API_BASE_URL=https://TUO-BACKEND.azurewebsites.net/api

VITE_USE_MOCK=false
