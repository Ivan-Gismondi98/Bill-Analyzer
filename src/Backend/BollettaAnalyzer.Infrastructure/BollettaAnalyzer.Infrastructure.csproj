<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BollettaAnalyzer.Application\BollettaAnalyzer.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Necessario per IHttpContextAccessor in CurrentUser. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- OCR bollette reali -->
    <!-- Estrazione testo da PDF digitali (100% gestito, nessuna dipendenza nativa). -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- OCR reale su immagini/scansioni. Su Linux richiede libtesseract/libleptonica + traineddata. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- Provider cloud opzionale per scansioni complesse. -->
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
  </ItemGroup>

</Project>
